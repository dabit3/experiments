  "deviations": [
    {
      "from": "Recommended Flame engine for rendering/game loop",
      "to": "Plain Flutter widgets + CustomPainter",
      "reason": "Bughouse is a turn-based board UI with discrete animations; Flutter's widget/animation layer gives identical rendering on all four targets with less code and no game-loop dependency. Recorded per the task instruction to deviate only with a stated reason."
    },
    {
      "from": "Hardware-accelerated Android emulator",
      "to": "AOSP ATD image under software TCG + SwiftShader",
      "reason": "Host reports kern.hv_support=0 (no HVF inside the VM). Release/AOT APK, longer clocks and command timeouts, and an explicit 3-frame screenshot sync keep the Android client deterministic; documented in README and audit-reliability.md."
    }
  ],
