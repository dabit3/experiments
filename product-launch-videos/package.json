{
  "name": "devin-product-launch-videos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets:setup": "python3 scripts/setup_assets.py",
    "assets:check": "python3 scripts/setup_assets.py --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/shared/*.test.ts scripts/*.test.ts && python3 -B -m unittest discover -s scripts -p '*_test.py'",
    "render": "tsx scripts/render.ts video",
    "still": "tsx scripts/render.ts still",
    "contact-sheet": "python3 scripts/contact_sheet.py",
    "templates:list": "tsx scripts/discover.ts",
    "studio": "remotion studio src/smoke/entry.tsx",
    "smoke:props": "tsx scripts/smoke-props.ts",
    "gallery": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build"
  },
  "dependencies": {
    "@remotion/player": "4.0.522",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.522"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@remotion/bundler": "4.0.522",
    "@remotion/cli": "4.0.522",
    "@remotion/renderer": "4.0.522",
    "@types/node": "22.18.0",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.9",
    "eslint": "9.34.0",
    "globals": "16.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.3.6"
  }
}
