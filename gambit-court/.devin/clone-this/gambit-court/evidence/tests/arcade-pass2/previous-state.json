    {
      "id": "android-emulator-runtime",
      "affects": [
        "journey-android-runtime",
        "journey-four-way-match"
      ],
      "summary": "The Android emulator cannot run on the verification host: kern.hv_support=0 (no hardware virtualization) and the arm64-v8a AVD hangs its QEMU CPU threads and crashes with EXC_BAD_ACCESS/SIGSEGV on every launch. The Android APK builds from a clean checkout, and the client is the same Flutter code + automation bridge as the three verified platforms.",
      "attempted": [
        "-gpu swiftshader_indirect / host / off",
        "-no-window -no-audio -no-boot-anim",
        "feature flags off",
        "cold boot without snapshot",
        "waiting > 4 minutes for adb device to come online"
      ],
      "resume_condition": "On a host with virtualization: `WHITE=macos BLACK=android ./test/multiplayer-e2e.sh` (or PLATFORMS=web,ios,android,macos) and re-run the final suite.",
      "evidence": [
        "evidence/tests/android/android-blocker.txt",
        "evidence/tests/android/emulator-launch-tail.txt",
        "evidence/tests/build/clean-checkout-build.txt"
      ]
