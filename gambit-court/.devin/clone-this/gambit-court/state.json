        "Current iOS Simulator gameplay and scoped unified-log inspection",
        "Inspected local sound assets and graceful playback failure handling"
      ],
      "resume_condition": "Verify move/capture/check/result sound on a Simulator host with a working audio device or a physical iOS device.",
      "evidence": [
        "evidence/tests/arcade-pass4/network/ios-runtime.log",
