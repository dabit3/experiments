{
  "_note": "Design tokens for Devin launch videos. Derived from the Devin product UI screenshots in ./screens and the brand lockups in ./brand. Treat as the source of truth for color, type, spacing and motion across all templates.",
  "color": {
    "black": "#000000",
    "ink": "#0A0A0A",
    "white": "#FFFFFF",
    "paper": "#FAFAFA",
    "surface": "#F5F5F5",
    "border": "#E5E5E5",
    "borderDark": "#262626",
    "gray900": "#171717",
    "gray700": "#404040",
    "gray500": "#737373",
    "gray400": "#A3A3A3",
    "gray300": "#D4D4D4",
    "darkBg": "#0B0B0C",
    "darkSurface": "#141416",
    "darkBorder": "#27272A",
    "accent": "#2F62E0",
    "accentSoft": "#E8EFFD",
    "accentGlow": "rgba(47, 98, 224, 0.35)",
    "violet": "#8838E0",
    "success": "#1F9D55",
    "successSoft": "#E6F5EC",
    "warning": "#D98E04",
    "danger": "#D93025",
    "cream": "#F6F3EE",
    "warmGray": "#8A8580"
  },
  "type": {
    "display": "Inter, -apple-system, 'SF Pro Display', 'Helvetica Neue', Helvetica, Arial, sans-serif",
    "body": "Inter, -apple-system, 'SF Pro Text', 'Helvetica Neue', Helvetica, Arial, sans-serif",
    "mono": "'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace",
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "sizes1080p": {
      "hero": 112,
      "h1": 80,
      "h2": 56,
      "h3": 40,
      "body": 28,
      "caption": 22,
      "label": 18
    },
    "tracking": { "hero": "-0.03em", "heading": "-0.02em", "body": "0", "caps": "0.08em" },
    "leading": { "tight": 1.02, "heading": 1.1, "body": 1.4 }
  },
  "space": {
    "unit": 8,
    "scale": [0, 8, 16, 24, 32, 48, 64, 96, 128, 192],
    "frameMargin1080p": 120,
    "safeAreaInset1080p": 80
  },
  "radius": { "sm": 8, "md": 12, "lg": 20, "xl": 28, "pill": 999 },
  "shadow": {
    "soft": "0 40px 80px -20px rgba(0,0,0,0.18), 0 12px 24px -12px rgba(0,0,0,0.10)",
    "card": "0 8px 24px rgba(0,0,0,0.08)",
    "dark": "0 40px 80px -20px rgba(0,0,0,0.6)"
  },
  "motion": {
    "fps": 30,
    "easeOut": [0.16, 1, 0.3, 1],
    "easeInOut": [0.65, 0, 0.35, 1],
    "durationMs": { "fast": 300, "base": 500, "slow": 800, "hold": 1800 },
    "rules": [
      "ease-out for entrances, ease-in-out for moves, ease-in for exits",
      "no more than two motion types per scene",
      "one idea on screen at a time",
      "generous negative space; nothing on screen that isn't doing work"
    ]
  },
  "video": { "width": 1920, "height": 1080, "fps": 30, "targetDurationSeconds": [35, 50] }
}
